        )
        foreach ($ndir in $netMemDirs) {
            if (-not (Test-Path $ndir)) { New-Item -Path $ndir -ItemType Directory -Force | Out-Null }
            for ($i = 1; $i -le $intensity; $i++) {
                $targetClone = Join-Path $ndir "sys_core_node_${i}$binaryExt"
